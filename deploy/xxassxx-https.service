# System service for Trader. Runs as ubuntu; capability only grants low-port binding.
[Unit]
Description=xXASSXx HTTPS endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/xxassxx-tools/caddy-2.11.7/caddy run --config /home/ubuntu/.config/xxassxx/Caddyfile --adapter caddyfile
ExecReload=/home/ubuntu/xxassxx-tools/caddy-2.11.7/caddy reload --config /home/ubuntu/.config/xxassxx/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
